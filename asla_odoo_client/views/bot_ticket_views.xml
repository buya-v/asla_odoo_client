<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_asla_bot_ticket_form" model="ir.ui.view">
        <field name="name">asla_client.ticket.form</field>
        <field name="model">asla_client.ticket</field>
        <field name="arch" type="xml">
            <form string="Ticket">
                <header>
                    <button name="action_submit" string="Resubmit to Hub"
                            type="object" invisible="hub_ref != False"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,triaged,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="subject"/>
                            <field name="category"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="hub_ref" readonly="1"/>
                            <field name="reporter_id"/>
                            <field name="lang"/>
                            <field name="response_category" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_asla_bot_ticket_list" model="ir.ui.view">
        <field name="name">asla_client.ticket.list</field>
        <field name="model">asla_client.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets" decoration-success="state == 'done'"
                  decoration-info="state == 'triaged'">
                <field name="name"/>
                <field name="subject"/>
                <field name="category"/>
                <field name="priority" widget="priority"/>
                <field name="hub_ref"/>
                <field name="state"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_asla_bot_ticket" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">asla_client.ticket</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
