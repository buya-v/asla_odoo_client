<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="partner_aslabot" model="res.partner">
            <field name="name">AslaBot</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="email">aslabot@asla.mn</field>
            <field name="active" eval="True"/>
            <field name="tz">Asia/Ulaanbaatar</field>
        </record>

        <!-- No password: this user exists so the partner is reachable in
             Discuss, not so anyone can log in as it. This module ships to
             public GitHub, and a constant password here would be a shared
             credential on every deployment. -->
        <record id="user_aslabot" model="res.users">
            <field name="partner_id" ref="partner_aslabot"/>
            <field name="login">aslabot</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
