<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_ai" name="My AI Studio">
        <t t-call="portal.portal_layout">
            <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
            <div class="container mt-4">
                <h3>Offline App Generator</h3>
                <div t-if="request.params.get('error')" class="alert alert-danger">
                    Error processing your request: <t t-esc="request.params.get('error')"/>
                </div>
                
                <div class="card mt-3 shadow-sm">
                    <div class="card-body">
                        <h5>Your API Key: <span class="text-primary"><t t-esc="api_key.api_key if api_key else 'None'"/></span></h5>
                        <h5>Credits Remaining: <strong class="text-success"><t t-esc="api_key.credit_balance if api_key else 0"/></strong></h5>
                        <hr/>
                        <form action="/my/ai/upload_rfp" method="POST" enctype="multipart/form-data">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            
                            <div class="form-group mb-4">
                                <label for="upload_file" class="font-weight-bold">1. Upload RFP (ZIP File)</label>
                                <p class="text-muted small">Upload the asla_rfp.zip file generated by your offline ASLA Client.</p>
                                <input type="file" id="upload_file" name="upload_file" class="form-control-file" accept=".zip" required="1"/>
                            </div>

                            <div class="form-group mb-4" id="rfp_preview_container" style="display:none;">
                                <label class="font-weight-bold text-success"><i class="fa fa-check-circle"></i> RFP Contents Extracted!</label>
                                <p class="text-muted small">Review or modify the exact payload we are sending to the AI below:</p>
                                <textarea id="rfp_content" name="rfp_content" class="form-control" rows="8" style="font-family: monospace;"></textarea>
                            </div>
                            
                            <button type="submit" class="btn btn-primary btn-lg mt-2">
                                <i class="fa fa-magic"></i> Generate &amp; Download App.zip (1 Credit)
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            
            <script>
                document.getElementById('upload_file').addEventListener('change', function(e) {
                    var file = e.target.files[0];
                    if (!file) return;
                    
                    var zip = new JSZip();
                    zip.loadAsync(file).then(function(zipFiles) {
                        if (zipFiles.file("rfp.json")) {
                            zipFiles.file("rfp.json").async("string").then(function(content) {
                                document.getElementById('rfp_content').value = content;
                                document.getElementById('rfp_preview_container').style.display = 'block';
                            });
                        } else {
                            alert("Invalid RFP ZIP: rfp.json not found inside the archive.");
                        }
                    });
                });
            </script>
        </t>
    </template>
</odoo>
