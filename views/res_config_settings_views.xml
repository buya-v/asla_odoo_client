<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.asla.studio</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AslaBot" string="AslaBot" name="asla_studio">
                    <block title="AslaBot AI Configuration" name="asla_studio_config">
                        <setting string="API Key" help="Your ASLA API Key from odoo.asla.mn">
                            <field name="asla_api_key"/>
                        </setting>
                        <setting string="Server URL" help="Usually https://odoo.asla.mn/api/v1/generate_odoo_app">
                            <field name="asla_api_url"/>
                        </setting>
                        <setting string="Operation Mode" help="Set the default operation mode for the AI Project generator.">
                            <field name="asla_operation_mode" widget="radio"/>
                                <field name="asla_generated_addons_path" placeholder="/opt/odoo/asla_generated"/>
                                <field name="asla_ai_url"/>
                                <field name="asla_ollama_url"/>
                                <field name="asla_ollama_model"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_asla_studio_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'asla_studio'}</field>
    </record>
</odoo>
