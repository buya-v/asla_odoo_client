<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_asla_bot" model="ir.module.category">
        <field name="name">AslaBot Agent</field>
        <field name="sequence">100</field>
    </record>

    <record id="group_asla_bot_user" model="res.groups">
        <field name="name">AslaBot Agent User</field>
        <field name="category_id" ref="module_category_asla_bot"/>
        <field name="comment">Can raise tickets and view answers.</field>
    </record>

    <record id="group_asla_bot_admin" model="res.groups">
        <field name="name">AslaBot Agent Administrator</field>
        <field name="category_id" ref="module_category_asla_bot"/>
        <field name="implied_ids" eval="[(4, ref('group_asla_bot_user'))]"/>
        <field name="comment">Configures the hub connection and approves operations.</field>
    </record>
</odoo>
